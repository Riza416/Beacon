# Supabase — paste from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — never expose to the client. Used by route handlers / server actions
# that need to bypass RLS (e.g. first-user-as-admin bootstrap).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Site origin used in magic-link redirect. Set to your Vercel preview / prod URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
