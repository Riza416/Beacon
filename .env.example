# Supabase — paste from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — never expose to the client. Used by route handlers / server actions
# that need to bypass RLS (e.g. first-user-as-admin bootstrap).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Site origin used in magic-link redirect. Set to your Vercel preview / prod URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (Resend) — powers workstream-owner alerts on new/updated
# requests. Server-only: RESEND_API_KEY must never be exposed to the browser.
# Until both are set, email alerts are skipped (the app still works).
#   - Create a key at https://resend.com and verify a sending domain.
#   - EMAIL_FROM must use a verified domain, e.g. "Beacon <beacon@example.com>".
RESEND_API_KEY=YOUR-RESEND-API-KEY
EMAIL_FROM=Beacon <beacon@example.com>
